#!/bin/sh /etc/rc.common
# Universal Traveler - OTA decode -> NMEA bridge, as an OpenWrt boot service (procd).
# Reads the radio audio off the USB sound card, decodes P25 GPS on the box, serves :10110.
# Install:  put in /etc/init.d/, chmod +x, then /etc/init.d/ut-bridge enable

USE_PROCD=1
START=95
STOP=10

start_service() {
    # Make sure the USB sound-card driver is up (harmless if hotplug already loaded it).
    modprobe snd-usb-audio 2>/dev/null

    # Free a Garmin GPS 18 USB from the kernel serial driver so the bridge's libusb reader
    # can claim it (the box's own "you are here" position). No-op if no Garmin is present.
    rmmod garmin_gps 2>/dev/null

    procd_open_instance
    procd_set_param command /usr/bin/python3 /root/ut_bridge.py
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
